                <source>You cannot import this datatype because it contains premium field type(s). Please upgrade to Tonictypes Professional to use these fields.</source>
            </trans-unit>
            <trans-unit id="error.no_selection">
                <source>Please select at least one datatype.</source>
            </trans-unit>
            <trans-unit id="error.no_file">
                <source>Please choose an archive file.</source>
            </trans-unit>
            <trans-unit id="error.no_target">
                <source>Please select a target storage page.</source>
            </trans-unit>
            <trans-unit id="error.no_mapping">
                <source>Please assign a storage page to each datatype in the preview.</source>
            </trans-unit>
